rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Los usuarios autenticados deben haber verificado su correo electrónico.
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Permite que una cuenta pendiente cree su propio perfil antes de verificar el correo.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isTeamLeaderUser(teamId, userId) {
      let memberPath = /databases/$(database)/documents/miembros_equipo/$(teamId + "_" + userId);
      return isAuthenticated() &&
        exists(memberPath) &&
        get(memberPath).data.id_rol != null &&
        isLeaderRole(get(memberPath).data.id_rol);
    }

    function isLeaderRole(roleId) {
      let rolePath = /databases/$(database)/documents/roles/$(roleId);
      return roleId != null &&
        exists(rolePath) &&
        get(rolePath).data.nombre_rol.matches('(?i).*l[ií]der.*');
    }

    function isTeamLeader(teamId) {
      return isTeamLeaderUser(teamId, request.auth.uid);
    }

    function isProjectCreator(projectId, userId) {
      let projectPath = /databases/$(database)/documents/proyecto/$(projectId);
      return exists(projectPath) && get(projectPath).data.id_creador == userId;
    }

    function isAcceptedLinkRequest(requestId, projectId, teamId) {
      let requestPath = /databases/$(database)/documents/solicitudes_proyecto_equipo/$(requestId);
      return getAfter(requestPath).data.tipo == 'vincular' &&
        getAfter(requestPath).data.estado == 'aceptada' &&
        getAfter(requestPath).data.id_proyecto == projectId &&
        getAfter(requestPath).data.id_equipo == teamId &&
        getAfter(requestPath).data.id_destinatario == request.auth.uid;
    }

    function isAcceptedUnlinkRequest(projectId, teamId) {
      let requestPath = /databases/$(database)/documents/solicitudes_proyecto_equipo/$(("desvincular_" + projectId) + "_" + teamId);
      return getAfter(requestPath).data.tipo == 'desvincular' &&
        getAfter(requestPath).data.estado == 'aceptada' &&
        getAfter(requestPath).data.id_proyecto == projectId &&
        getAfter(requestPath).data.id_equipo == teamId &&
        getAfter(requestPath).data.id_destinatario == request.auth.uid;
    }

    function isValidProjectTeamResponse(requestId, data) {
      let relationPath = /databases/$(database)/documents/proyecto_equipos/$(data.id_proyecto + "_" + data.id_equipo);
      return data.estado == 'rechazada' ||
        (
          data.estado == 'aceptada' &&
          (
            (
              data.tipo == 'vincular' &&
              isTeamLeader(data.id_equipo) &&
              existsAfter(relationPath) &&
              getAfter(relationPath).data.id_solicitud == requestId &&
              getAfter(relationPath).data.get('estado', 'activo') == 'activo'
            ) ||
            (
              data.tipo == 'desvincular' &&
              (
                isTeamLeader(data.id_equipo) ||
                isProjectCreator(data.id_proyecto, request.auth.uid)
              ) &&
              (
                !existsAfter(relationPath) ||
                getAfter(relationPath).data.get('estado', 'activo') == 'desvinculado'
              )
            )
          )
        );
    }

    function isValidProjectTeamRequest(data, requestId) {
      let projectPath = /databases/$(database)/documents/proyecto/$(data.id_proyecto);
      let teamPath = /databases/$(database)/documents/equipo/$(data.id_equipo);
      let relationPath = /databases/$(database)/documents/proyecto_equipos/$(data.id_proyecto + "_" + data.id_equipo);
      return data.id_solicitante == request.auth.uid &&
        data.id_destinatario != request.auth.uid &&
        data.estado == 'pendiente' &&
        exists(projectPath) &&
        exists(teamPath) &&
        (
          (
            data.tipo == 'vincular' &&
            requestId == 'vincular_' + data.id_proyecto + "_" + data.id_equipo &&
            isProjectCreator(data.id_proyecto, request.auth.uid) &&
            isTeamLeaderUser(data.id_equipo, data.id_destinatario) &&
            (
              !exists(relationPath) ||
              get(relationPath).data.get('estado', 'activo') == 'desvinculado'
            )
          ) ||
          (
            data.tipo == 'desvincular' &&
            requestId == 'desvincular_' + data.id_proyecto + "_" + data.id_equipo &&
            exists(relationPath) &&
            get(relationPath).data.get('estado', 'activo') == 'activo' &&
            (
              (
                isProjectCreator(data.id_proyecto, request.auth.uid) &&
                isTeamLeaderUser(data.id_equipo, data.id_destinatario)
              ) ||
              (
                isTeamLeader(data.id_equipo) &&
                isProjectCreator(data.id_proyecto, data.id_destinatario)
              )
            )
          )
        );
    }

    // ¿Pertenece este equipo y está ACTIVO en el proyecto?
    function isEquipoDelProyecto(equipoId, proyectoId) {
      let equipoPath = /databases/$(database)/documents/equipo/$(equipoId);
      let vinculoPath = /databases/$(database)/documents/proyecto_equipos/$(proyectoId + "_" + equipoId);
      return equipoId != null &&
        proyectoId != null &&
        (
          (
            exists(vinculoPath) &&
            get(vinculoPath).data.get('estado', 'activo') == 'activo'
          ) ||
          (
            !exists(vinculoPath) &&
            exists(equipoPath) &&
            get(equipoPath).data.get('id_proyecto', null) == proyectoId
          )
        );
    }

    // ¿Es el usuario miembro activo de un equipo activo dentro del proyecto?
    // Respeta las modificaciones locales en `miembros_proyecto_equipo` y cae a la plantilla
    // global `miembros_equipo` cuando aún no existe ficha local para ese par proyecto-equipo.
    function esMiembroDeEquipoEnProyecto(projectId, equipoId, userId) {
      let localPath = /databases/$(database)/documents/miembros_proyecto_equipo/$(projectId + "_" + equipoId + "_" + userId);
      let globalPath = /databases/$(database)/documents/miembros_equipo/$(equipoId + "_" + userId);
      return isEquipoDelProyecto(equipoId, projectId) &&
        (
          exists(localPath)
            ? get(localPath).data.get('estado', 'activo') == 'activo'
            : exists(globalPath)
        );
    }

    // ¿Tiene el usuario rol de líder activo en el equipo dentro de este proyecto?
    function isProjectTeamLeaderUser(projectId, equipoId, userId) {
      let localPath = /databases/$(database)/documents/miembros_proyecto_equipo/$(projectId + "_" + equipoId + "_" + userId);
      return isEquipoDelProyecto(equipoId, projectId) &&
        (
          exists(localPath)
            ? (
                get(localPath).data.get('estado', 'activo') == 'activo' &&
                isLeaderRole(get(localPath).data.get('id_rol', null))
              )
            : isTeamLeaderUser(equipoId, userId)
        );
    }

    // Membresía general del proyecto: su creador o quien pertenece a un equipo activo
    // vinculado al proyecto (validado mediante el puntero `acceso_comentarios/{uid}`).
    function esMiembroDelProyecto(projectId, userId) {
      let projectPath = /databases/$(database)/documents/proyecto/$(projectId);
      return exists(projectPath) && (
        get(projectPath).data.get('id_creador', null) == userId ||
        userId in get(projectPath).data.get('ids_miembros', []) ||
        esMiembroPorEquipoVinculadoConPuntero(projectId, userId)
      );
    }

    function esMiembroDelProyectoConEquipos(projectId, userId) {
      return esMiembroDelProyecto(projectId, userId);
    }

    function esMiembroPorEquipoVinculadoConPuntero(projectId, userId) {
      let accesoPath = /databases/$(database)/documents/proyecto/$(projectId)/acceso_comentarios/$(userId);
      let equipoId = exists(accesoPath)
        ? get(accesoPath).data.get('id_equipo', '')
        : '';
      return equipoId is string &&
        equipoId != '' &&
        esMiembroDeEquipoEnProyecto(projectId, equipoId, userId);
    }

    function puedeCrearEquipoEnProyecto(projectId, userId) {
      let projectPath = /databases/$(database)/documents/proyecto/$(projectId);
      return exists(projectPath) && (
        get(projectPath).data.get('id_creador', null) == userId ||
        esMiembroDelProyecto(projectId, userId)
      );
    }

    function isValidTeamRole(roleId) {
      return roleId == null ||
        exists(/databases/$(database)/documents/roles/$(roleId));
    }

    function isAllowedMemberCreate(memberId) {
      let teamPath = /databases/$(database)/documents/equipo/$(request.resource.data.id_equipo);
      let invitationPath = /databases/$(database)/documents/invitaciones_equipo/$(request.resource.data.id_equipo + "_" + request.auth.uid);
      return isAuthenticated() &&
        memberId == request.resource.data.id_equipo + "_" + request.resource.data.id_usuario &&
        request.resource.data.id_usuario == request.auth.uid &&
        (
          (
            existsAfter(teamPath) &&
            getAfter(teamPath).data.id_creador == request.auth.uid &&
            isLeaderRole(request.resource.data.id_rol)
          ) ||
          (
            existsAfter(invitationPath) &&
            getAfter(invitationPath).data.id_invitado == request.auth.uid &&
            getAfter(invitationPath).data.id_equipo == request.resource.data.id_equipo &&
            getAfter(invitationPath).data.id_rol == request.resource.data.id_rol &&
            getAfter(invitationPath).data.estado == 'aceptada'
          )
        );
    }

    function puedeEditarCatalogos() {
      return false;
    }

    // ==========================================
    // APROBACIÓN DE REQUERIMIENTOS (KAN-18)
    // ==========================================
    function esAprobadorEnProyecto(proyectoId, equipoId, userId) {
      return isProjectTeamLeaderUser(proyectoId, equipoId, userId);
    }

    // Los estados del ciclo de aprobación, comparados por su texto exacto.
    //
    // El catálogo guarda el nombre, no el significado: el significado de un ID
    // depende de lo que diga el documento `estados` al que apunta. Por eso `estados`
    // queda congelado como `roles`. Si alguien añadiera "Pendiente de aprobacion"
    // sin tilde, los requerimientos dejarían de reconocerse como pendientes y el
    // flujo se pararía sin error visible.
    function esEstadoPendienteAprobacion(estadoId) {
      let estadoPath = /databases/$(database)/documents/estados/$(estadoId);
      return estadoId != null &&
        exists(estadoPath) &&
        get(estadoPath).data.nombre_estado == 'Pendiente de aprobación';
    }

    function esEstadoAprobado(estadoId) {
      let estadoPath = /databases/$(database)/documents/estados/$(estadoId);
      return estadoId != null &&
        exists(estadoPath) &&
        get(estadoPath).data.nombre_estado == 'Aprobado';
    }

    function esEstadoRechazado(estadoId) {
      let estadoPath = /databases/$(database)/documents/estados/$(estadoId);
      return estadoId != null &&
        exists(estadoPath) &&
        get(estadoPath).data.nombre_estado == 'Rechazado';
    }

    function isValidRequerimientoCreate(data) {
      return isAuthenticated() &&
        (
          esMiembroDeEquipoEnProyecto(data.id_proyecto, data.id_equipo, request.auth.uid) ||
          esMiembroDelProyecto(data.id_proyecto, request.auth.uid)
        ) &&
        isEquipoDelProyecto(data.id_equipo, data.id_proyecto) &&
        data.id_autor == request.auth.uid &&
        data.id_aprobador == null &&
        esEstadoPendienteAprobacion(data.id_estado) &&
        data.enunciado is string &&
        data.enunciado.size() > 0 &&
        data.enunciado.size() <= 5000 &&
        data.keys().hasOnly([
          'enunciado', 'id_tipo_requerimiento', 'id_proyecto', 'id_equipo',
          'id_autor', 'id_aprobador', 'id_modalidad', 'id_estado', 'id_modelo',
          'id_patron', 'numero', 'codigo', 'created_at',
          'modulo', 'origen_ia', 'prioridad', 'elementos_sintaxis'
        ]) &&
        sonValidosCamposIA(data);
    }

    function esElementoSintaxisValido(item) {
      return item is map &&
        item.keys().hasOnly(['elemento', 'fragmento']) &&
        item.elemento is string && item.elemento.size() > 0 && item.elemento.size() <= 80 &&
        item.fragmento is string && item.fragmento.size() > 0 && item.fragmento.size() <= 1000;
    }

    function esValidaSintaxisIA(lista) {
      return lista == null || (
        lista is list &&
        lista.size() <= 12 &&
        (lista.size() == 0 || esElementoSintaxisValido(lista[0]))
      );
    }

    // Campos opcionales de la generación con IA (KAN-40). Ausentes o null valen siempre (los
    // requerimientos a mano y los anteriores no los tienen); si vienen, con su tipo y tamaño.
    function sonValidosCamposIA(data) {
      return (
          data.get('modulo', null) == null ||
          (data.modulo is string && data.modulo.size() <= 120)
        ) &&
        (data.get('origen_ia', null) == null || data.origen_ia in ['explicito', 'inferido']) &&
        (data.get('prioridad', null) == null || data.prioridad in ['Must', 'Should', 'Could', 'Wont']) &&
        esValidaSintaxisIA(data.get('elementos_sintaxis', null));
    }

    // Un requerimiento se actualiza por UNA de estas cinco situaciones. Se
    // declaran por separado para que se lea cuál es cuál.

    // 1. El autor corrige el suyo y lo devuelve a espera.
    function esReenvioDelAutor(data) {
      return isAuthenticated() &&
        resource.data.id_autor == request.auth.uid &&
        !data.diff(resource.data).affectedKeys().hasAny([
          'id_autor', 'id_proyecto', 'id_equipo', 'id_aprobador', 'numero', 'codigo'
        ]) &&
        (
          !data.diff(resource.data).affectedKeys().hasAny(['id_estado']) ||
          esEstadoPendienteAprobacion(data.id_estado)
        );
    }

    // 2. El líder del equipo (evaluado en el ámbito del proyecto) aprueba o rechaza.
    function esDecisionDelAprobador(data) {
      return esAprobadorEnProyecto(resource.data.id_proyecto, resource.data.id_equipo, request.auth.uid) &&
        esEstadoPendienteAprobacion(resource.data.id_estado) &&
        data.diff(resource.data).affectedKeys().hasOnly(['id_estado', 'id_aprobador']) &&
        (esEstadoAprobado(data.id_estado) || esEstadoRechazado(data.id_estado)) &&
        (esEstadoAprobado(data.id_estado)
          ? data.id_aprobador == request.auth.uid
          : data.id_aprobador == null);
    }

    // 3. Superada la aprobación, el requerimiento vuelve al flujo normal y se edita
    // por cualquier miembro activo del proyecto o del equipo del requerimiento.
    function esEdicionEnFlujoNormal(data) {
      return (
          esMiembroDeEquipoEnProyecto(resource.data.id_proyecto, resource.data.id_equipo, request.auth.uid) ||
          esMiembroDelProyecto(resource.data.id_proyecto, request.auth.uid)
        ) &&
        !esEstadoPendienteAprobacion(resource.data.id_estado) &&
        !esEstadoRechazado(resource.data.id_estado) &&
        !data.diff(resource.data).affectedKeys().hasAny([
          'id_autor', 'id_proyecto', 'id_equipo'
        ]);
    }

    // 4. Renumeración.
    function esRenumeracion(data) {
      return isAuthenticated() &&
        data.diff(resource.data).affectedKeys().hasOnly(['numero', 'codigo']);
    }

    // 5. El contador de comentarios (KAN-27).
    function esConteoComentarios(data) {
      return data.diff(resource.data).affectedKeys().hasOnly(['total_comentarios']) &&
        (
          esMiembroDeEquipoEnProyecto(resource.data.id_proyecto, resource.data.id_equipo, request.auth.uid) ||
          esMiembroDelProyectoConEquipos(resource.data.id_proyecto, request.auth.uid)
        );
    }

    // 1. Perfiles de usuario
    match /perfil_usuario/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // 2. Catálogos base (profesiones, roles, estados, estado_proyecto, naturaleza_proyecto, modalidades, tipos, modelos)
    match /profesiones/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /tipos_sistema/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    match /roles/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['nombre_rol']) &&
        request.resource.data.nombre_rol in [
          'Líder de Equipo',
          'Analista de Requisitos',
          'Desarrollador',
          'Tester QA',
          'Product Owner'
        ];
      allow update, delete: if false;
    }
    match /estados/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['nombre_estado']) &&
        request.resource.data.nombre_estado in [
          'Borrador',
          'En Revisión',
          'Aprobado',
          'Rechazado',
          'Implementado',
          'Pendiente de aprobación'
        ];
      allow update, delete: if false;
    }
    match /estado_proyecto/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['nombre_estado']) &&
        request.resource.data.nombre_estado is string &&
        request.resource.data.nombre_estado.size() > 0 &&
        request.resource.data.nombre_estado.size() <= 80;
      allow update, delete: if puedeEditarCatalogos();
    }
    match /naturaleza_proyecto/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['nombre_naturaleza']) &&
        request.resource.data.nombre_naturaleza is string &&
        request.resource.data.nombre_naturaleza.size() > 0 &&
        request.resource.data.nombre_naturaleza.size() <= 80;
      allow update, delete: if puedeEditarCatalogos();
    }
    match /modalidades/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['nombre_modalidad']) &&
        request.resource.data.nombre_modalidad in [
          'Presencial',
          'Remoto',
          'Híbrido',
          'Obligatorio',
          'Opcional',
          'Generado con IA'
        ];
      allow update, delete: if false;
    }
    match /tipos_requerimientos/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    match /modelo/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if puedeEditarCatalogos();
    }

    // 3. Proyectos y Colaboraciones
    match /proyecto/{proyectoId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.id_creador == request.auth.uid;
      allow update: if isAuthenticated() &&
        (
          (
            !resource.data.keys().hasAny(['id_creador']) &&
            !request.resource.data.keys().hasAny(['id_creador'])
          ) ||
          request.resource.data.id_creador == resource.data.id_creador
        );
      allow delete: if isAuthenticated();

      // Puntero de acceso al proyecto y a los hilos de comentarios para quien entra por un
      // equipo activo vinculado. Las reglas revalidan en cada operación que el equipo siga
      // activo y el usuario siga activo en ese equipo.
      match /acceso_comentarios/{userId} {
        function equipoValido() {
          let equipoId = request.resource.data.get('id_equipo', null);
          return request.resource.data.keys().hasOnly(['id_equipo']) &&
            equipoId is string &&
            esMiembroDeEquipoEnProyecto(proyectoId, equipoId, userId);
        }

        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() &&
          (
            request.auth.uid == userId ||
            isProjectCreator(proyectoId, request.auth.uid)
          ) &&
          equipoValido();
        allow delete: if isAuthenticated() && (
          request.auth.uid == userId ||
          isProjectCreator(proyectoId, request.auth.uid) ||
          !exists(/databases/$(database)/documents/proyecto/$(proyectoId))
        );
      }
    }

    match /colaboracion/{colaboracionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.id_creador == request.auth.uid &&
        request.resource.data.nombre is string &&
        request.resource.data.nombre.size() > 0 &&
        request.resource.data.nombre.size() <= 200;
      allow update: if isAuthenticated() &&
        (
          resource.data.get('id_creador', null) == null ||
          resource.data.id_creador == request.auth.uid
        ) &&
        request.resource.data.get('id_creador', null) == resource.data.get('id_creador', null);
      allow delete: if isAuthenticated() &&
        (
          resource.data.get('id_creador', null) == null ||
          resource.data.id_creador == request.auth.uid
        );
    }

    match /colaboracion_proyecto/{relId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        relId == request.resource.data.id_colaboracion + "_" + request.resource.data.id_proyecto &&
        request.resource.data.id_autor == request.auth.uid &&
        existsAfter(/databases/$(database)/documents/colaboracion/$(request.resource.data.id_colaboracion)) &&
        existsAfter(/databases/$(database)/documents/proyecto/$(request.resource.data.id_proyecto));
      allow update: if false;
      allow delete: if isAuthenticated() && (
        resource.data.get('id_autor', null) == request.auth.uid ||
        isProjectCreator(resource.data.id_proyecto, request.auth.uid) ||
        !exists(/databases/$(database)/documents/proyecto/$(resource.data.id_proyecto)) ||
        !exists(/databases/$(database)/documents/colaboracion/$(resource.data.id_colaboracion))
      );
    }

    // 4. Equipos globales, vinculación con estado, miembros locales por proyecto e historial
    match /equipo/{equipoId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.id_creador == request.auth.uid &&
        (
          request.resource.data.get('id_proyecto', null) == null ||
          puedeCrearEquipoEnProyecto(request.resource.data.id_proyecto, request.auth.uid)
        );
      allow update: if isAuthenticated() &&
        isTeamLeader(equipoId) &&
        (
          (
            !resource.data.keys().hasAny(['id_creador']) &&
            !request.resource.data.keys().hasAny(['id_creador'])
          ) ||
          request.resource.data.id_creador == resource.data.id_creador
        );
      allow delete: if isAuthenticated() && (
        isTeamLeader(equipoId) ||
        (
          resource.data.get('id_proyecto', null) != null &&
          !exists(/databases/$(database)/documents/proyecto/$(resource.data.id_proyecto))
        )
      );
    }

    match /proyecto_equipos/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        docId == request.resource.data.id_proyecto + "_" + request.resource.data.id_equipo &&
        request.resource.data.get('estado', 'activo') in ['activo', 'desvinculado'] &&
        (
          (
            // Vínculo aceptado por solicitud
            request.resource.data.id_solicitud == "vincular_" + request.resource.data.id_proyecto + "_" + request.resource.data.id_equipo &&
            isAcceptedLinkRequest(
              request.resource.data.id_solicitud,
              request.resource.data.id_proyecto,
              request.resource.data.id_equipo
            ) &&
            isTeamLeader(request.resource.data.id_equipo)
          ) ||
          (
            // Asignación directa: el creador del proyecto lidera el equipo global
            isProjectCreator(request.resource.data.id_proyecto, request.auth.uid) &&
            isTeamLeader(request.resource.data.id_equipo)
          ) ||
          (
            // Creación de equipo y vínculo en el mismo lote
            existsAfter(/databases/$(database)/documents/equipo/$(request.resource.data.id_equipo)) &&
            getAfter(/databases/$(database)/documents/equipo/$(request.resource.data.id_equipo)).data.id_creador == request.auth.uid &&
            puedeCrearEquipoEnProyecto(request.resource.data.id_proyecto, request.auth.uid)
          )
        );
      allow update: if isAuthenticated() &&
        docId == resource.data.id_proyecto + "_" + resource.data.id_equipo &&
        request.resource.data.id_proyecto == resource.data.id_proyecto &&
        request.resource.data.id_equipo == resource.data.id_equipo &&
        request.resource.data.get('estado', 'activo') in ['activo', 'desvinculado'] &&
        (
          (
            // Cambio directo de estado cuando quien opera es creador del proyecto y líder del equipo
            isProjectCreator(resource.data.id_proyecto, request.auth.uid) &&
            (
              isTeamLeader(resource.data.id_equipo) ||
              isProjectTeamLeaderUser(resource.data.id_proyecto, resource.data.id_equipo, request.auth.uid)
            )
          ) ||
          (
            // Reactivación por solicitud aceptada
            request.resource.data.get('estado', 'activo') == 'activo' &&
            request.resource.data.id_solicitud == "vincular_" + resource.data.id_proyecto + "_" + resource.data.id_equipo &&
            isAcceptedLinkRequest(
              request.resource.data.id_solicitud,
              resource.data.id_proyecto,
              resource.data.id_equipo
            ) &&
            isTeamLeader(resource.data.id_equipo)
          ) ||
          (
            // Desvinculación por solicitud aceptada (conservando el registro con estado 'desvinculado')
            request.resource.data.get('estado', 'activo') == 'desvinculado' &&
            isAcceptedUnlinkRequest(resource.data.id_proyecto, resource.data.id_equipo) &&
            (
              isTeamLeader(resource.data.id_equipo) ||
              isProjectCreator(resource.data.id_proyecto, request.auth.uid)
            )
          )
        );
      allow delete: if isAuthenticated() && (
        !exists(/databases/$(database)/documents/proyecto/$(resource.data.id_proyecto)) ||
        !exists(/databases/$(database)/documents/equipo/$(resource.data.id_equipo)) ||
        isAcceptedUnlinkRequest(resource.data.id_proyecto, resource.data.id_equipo)
      );
    }

    match /miembros_equipo/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAllowedMemberCreate(docId);
      allow update: if isAuthenticated() &&
        isTeamLeader(resource.data.id_equipo) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['id_rol', 'id_roles']) &&
        request.resource.data.id_roles is list &&
        (
          (request.resource.data.id_roles.size() == 0 && request.resource.data.id_rol == null) ||
          (request.resource.data.id_roles.size() > 0 && request.resource.data.id_rol == request.resource.data.id_roles[0])
        ) &&
        isValidTeamRole(request.resource.data.id_rol);
      allow delete: if isAuthenticated() && (
        !exists(/databases/$(database)/documents/equipo/$(resource.data.id_equipo)) ||
        (
          isTeamLeader(resource.data.id_equipo) &&
          resource.data.id_usuario != request.auth.uid
        )
      );
    }

    match /miembros_proyecto_equipo/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
        docId == request.resource.data.id_proyecto + "_" + request.resource.data.id_equipo + "_" + request.resource.data.id_usuario &&
        request.resource.data.estado in ['activo', 'inactivo'] &&
        request.resource.data.id_roles is list &&
        (
          (request.resource.data.id_roles.size() == 0 && request.resource.data.id_rol == null) ||
          (request.resource.data.id_roles.size() > 0 && request.resource.data.id_rol == request.resource.data.id_roles[0])
        ) &&
        isValidTeamRole(request.resource.data.id_rol) &&
        (
          isProjectCreator(request.resource.data.id_proyecto, request.auth.uid) ||
          isTeamLeader(request.resource.data.id_equipo) ||
          isProjectTeamLeaderUser(request.resource.data.id_proyecto, request.resource.data.id_equipo, request.auth.uid) ||
          (
            existsAfter(/databases/$(database)/documents/equipo/$(request.resource.data.id_equipo)) &&
            getAfter(/databases/$(database)/documents/equipo/$(request.resource.data.id_equipo)).data.id_creador == request.auth.uid
          )
        );
      allow delete: if isAuthenticated() && (
        !exists(/databases/$(database)/documents/proyecto/$(resource.data.id_proyecto)) ||
        !exists(/databases/$(database)/documents/equipo/$(resource.data.id_equipo)) ||
        isProjectCreator(resource.data.id_proyecto, request.auth.uid) ||
        isTeamLeader(resource.data.id_equipo) ||
        isProjectTeamLeaderUser(resource.data.id_proyecto, resource.data.id_equipo, request.auth.uid)
      );
    }

    match /logs_integrantes/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'id_equipo', 'id_proyecto', 'id_usuario_afectado', 'accion',
          'id_autor', 'id_lider_en_momento', 'fecha_hora', 'detalles'
        ]) &&
        request.resource.data.id_autor == request.auth.uid &&
        request.resource.data.id_equipo is string &&
        request.resource.data.accion in [
          'alta', 'baja', 'cambio_roles', 'cambio_estado', 'clonado_proyecto'
        ] &&
        request.resource.data.fecha_hora is string;
      allow update, delete: if false;
    }

    match /invitaciones_equipo/{invitationId} {
      allow get: if isAuthenticated() && (
        resource == null ||
        resource.data.id_invitado == request.auth.uid ||
        resource.data.id_invitador == request.auth.uid ||
        isTeamLeader(resource.data.id_equipo)
      );
      allow list: if isAuthenticated() && (
        resource.data.id_invitado == request.auth.uid ||
        resource.data.id_invitador == request.auth.uid ||
        isTeamLeader(resource.data.id_equipo)
      );
      allow create: if isAuthenticated() &&
        request.resource.data.id_invitador == request.auth.uid &&
        request.resource.data.estado == 'pendiente' &&
        request.resource.data.id_invitado != request.auth.uid &&
        invitationId == request.resource.data.id_equipo + "_" + request.resource.data.id_invitado &&
        isTeamLeader(request.resource.data.id_equipo) &&
        isValidTeamRole(request.resource.data.id_rol) &&
        !exists(/databases/$(database)/documents/miembros_equipo/$(request.resource.data.id_equipo + "_" + request.resource.data.id_invitado));
      allow update: if isAuthenticated() && (
        (
          resource.data.id_invitado == request.auth.uid &&
          resource.data.estado == 'pendiente' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']) &&
          request.resource.data.estado in ['aceptada', 'rechazada']
        ) ||
        (
          resource.data.estado != 'pendiente' &&
          isTeamLeader(resource.data.id_equipo) &&
          request.resource.data.id_invitador == request.auth.uid &&
          request.resource.data.id_equipo == resource.data.id_equipo &&
          request.resource.data.id_invitado == resource.data.id_invitado &&
          request.resource.data.estado == 'pendiente' &&
          isValidTeamRole(request.resource.data.id_rol) &&
          !exists(/databases/$(database)/documents/miembros_equipo/$(resource.data.id_equipo + "_" + resource.data.id_invitado))
        )
      );
      allow delete: if isAuthenticated() && (
        isTeamLeader(resource.data.id_equipo) ||
        !exists(/databases/$(database)/documents/equipo/$(resource.data.id_equipo))
      );
    }
    match /solicitudes_proyecto_equipo/{requestId} {
      allow get: if isAuthenticated() && (
        resource == null ||
        resource.data.id_destinatario == request.auth.uid ||
        resource.data.id_solicitante == request.auth.uid ||
        !exists(/databases/$(database)/documents/proyecto/$(resource.data.id_proyecto)) ||
        !exists(/databases/$(database)/documents/equipo/$(resource.data.id_equipo))
      );
      allow list: if isAuthenticated() && (
        resource.data.id_destinatario == request.auth.uid ||
        resource.data.id_solicitante == request.auth.uid ||
        !exists(/databases/$(database)/documents/proyecto/$(resource.data.id_proyecto)) ||
        !exists(/databases/$(database)/documents/equipo/$(resource.data.id_equipo))
      );
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'id_proyecto', 'id_equipo', 'id_solicitante', 'id_destinatario',
          'tipo', 'estado', 'nombre_proyecto', 'nombre_equipo',
          'nombre_solicitante', 'created_at'
        ]) &&
        request.resource.data.keys().hasAll([
          'id_proyecto', 'id_equipo', 'id_solicitante', 'id_destinatario',
          'tipo', 'estado', 'nombre_proyecto', 'nombre_equipo',
          'nombre_solicitante', 'created_at'
        ]) &&
        isValidProjectTeamRequest(request.resource.data, requestId);
      allow update: if isAuthenticated() && (
        (
          resource.data.id_destinatario == request.auth.uid &&
          resource.data.estado == 'pendiente' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']) &&
          request.resource.data.estado in ['aceptada', 'rechazada'] &&
          isValidProjectTeamResponse(requestId, request.resource.data)
        ) ||
        (
          resource.data.estado != 'pendiente' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'id_solicitante', 'id_destinatario', 'estado',
            'nombre_solicitante', 'nombre_proyecto', 'nombre_equipo', 'created_at'
          ]) &&
          request.resource.data.id_proyecto == resource.data.id_proyecto &&
          request.resource.data.id_equipo == resource.data.id_equipo &&
          request.resource.data.tipo == resource.data.tipo &&
          isValidProjectTeamRequest(request.resource.data, requestId)
        )
      );
      allow delete: if isAuthenticated() && (
        resource.data.id_solicitante == request.auth.uid ||
        !exists(/databases/$(database)/documents/proyecto/$(resource.data.id_proyecto)) ||
        !exists(/databases/$(database)/documents/equipo/$(resource.data.id_equipo))
      );
    }

    // 5. Requerimientos con aprobación del líder del equipo (KAN-18)
    //
    // Antes era `allow read, write: if isAuthenticated()`: cualquier autenticado
    // podía crear, reescribir y borrar requerimientos, y autoaprobarse. Ahora el
    // autor lo pone el sistema, el estado inicial lo pone la regla, y aprobar es
    // solo del líder del equipo al que pertenece.
    //
    // Lo que sigue abierto: `delete`. KAN-18 habla de crear, editar y aprobar, no de
    // borrar, así que no se toca. Cerrar ese hueco aquí escondería un cambio de
    // comportamiento que nadie pidió, y dejaría KAN-18 mezclado con otro ticket.
    match /requerimiento/{requerimientoId} {
      allow read: if isAuthenticated();
      allow create: if isValidRequerimientoCreate(request.resource.data);
      // KAN-40: una edición tampoco puede dejar el módulo, el origen o la prioridad con un
      // valor que el alta no admitiría.
      //
      // KAN-27: el contador va primero dentro del paréntesis: su diff es barato de
      // descartar en las otras vías y, cuando sí es un contador, evita evaluar las
      // vías que leen estado y equipo. En la transacción del comentario ese ahorro
      // es obligatorio.
      allow update: if sonValidosCamposIA(request.resource.data) && (
        esConteoComentarios(request.resource.data) ||
        esReenvioDelAutor(request.resource.data) ||
        esDecisionDelAprobador(request.resource.data) ||
        esEdicionEnFlujoNormal(request.resource.data) ||
        esRenumeracion(request.resource.data)
      );
      allow delete: if isAuthenticated();

      // Comentarios del requerimiento (KAN-27).
      //
      // Cuelgan del propio requerimiento y no viven en una colección de nivel
      // superior, y la elección es de seguridad y no de comodidad: las reglas de
      // Firestore no pueden inspeccionar el contenido de los documentos cuando la
      // operación es una lista (una consulta), así que todo lo que necesite una
      // regla de lectura tiene que salir del path. Con el ID del requerimiento en
      // el path, la comprobación de membresía es una lectura de clave conocida y
      // tanto el `get` del hilo como su consulta funcionan. Con una colección
      // plana no habría forma de saber a qué proyecto pertenece el resultado sin
      // leer cada documento, y habría que dejar `read` abierto a todo el que tiene
      // sesión o negar la consulta entera: los dos extremos rompen el ticket.
      //
      // Consecuencia: los comentarios NO hacen cascada. Borrar un requerimiento no
      // se lleva su subcolección (Firestore no borra por debajo), así que eso lo
      // hace el servicio, y el orden en que lo hace importa. Ver la rama huérfana
      // de `allow delete`.
      match /comentario/{comentarioId} {
        function requerimientoDelHilo() {
          return /databases/$(database)/documents/requerimiento/$(requerimientoId);
        }

        // Quien entra al hilo: los miembros del proyecto del requerimiento al que
        // cuelga. El requerimiento se resuelve leyendo una clave conocida del path
        // y de ahí se sigue hasta el proyecto. El `exists` previo evita llamar a
        // `get()` sobre un requerimiento ya borrado.
        function esMiembroDelHilo(userId) {
          let requerimientoPath = requerimientoDelHilo();
          // Mismo motivo que en el proyecto: no se llama a `get()` si el
          // requerimiento ya no existe. Así la rama huérfana del borrado puede
          // evaluarse sin un error de servicio.
          return exists(requerimientoPath) &&
            esMiembroDelProyectoConEquipos(
              get(requerimientoPath).data.id_proyecto,
              userId
            );
        }

        function esAutorDelProyectoDelHilo(userId) {
          let requerimientoPath = requerimientoDelHilo();
          return exists(requerimientoPath) &&
            isProjectCreator(
              get(requerimientoPath).data.id_proyecto,
              userId
            );
        }

        // `allow read` cubre el `get` y la consulta del hilo: en ninguno de los dos
        // se usa `resource`, que es justamente lo que hace posible que la consulta
        // funcione.
        allow read: if isAuthenticated() && esMiembroDelHilo(request.auth.uid);

        allow create: if isAuthenticated() &&
          esMiembroDelHilo(request.auth.uid) &&
          // El autor lo pone el sistema, igual que en el requerimiento: el
          // formulario no lo trae y las reglas lo exigen igual al de la sesión.
          request.resource.data.id_autor == request.auth.uid &&
          request.resource.data.id_requerimiento == requerimientoId &&
          // El proyecto es el del requerimiento del path, no el que diga el
          // cliente. Así un comentario no se puede colgar de un proyecto ajeno
          // cambiando el campo, y la consulta del hilo sigue siendo la única
          // fuente de verdad.
          request.resource.data.id_proyecto == get(requerimientoDelHilo()).data.id_proyecto &&
          // `serverTimestamp()` se resuelve como `request.time` en las reglas: la
          // fecha la pone el servidor y no el reloj del navegador.
          request.resource.data.created_at == request.time &&
          !request.resource.data.keys().hasAny(['updated_at']) &&
          request.resource.data.texto is string &&
          request.resource.data.texto.size() > 0 &&
          request.resource.data.texto.size() <= 4000 &&
          request.resource.data.keys().hasOnly([
            'id_proyecto', 'id_requerimiento', 'id_autor', 'texto', 'created_at'
          ]);

        allow update: if isAuthenticated() &&
          esMiembroDelHilo(request.auth.uid) &&
          // Solo su autor, y solo el texto con su marca de corrección. Sin esta
          // lista, quien puede comentar podría reescribir un comentario ajeno o
          // cambiarle el autor. El documento nuevo es `request.resource.data`, y
          // el diff se hace contra `resource.data`: aquí NO existe una variable
          // `data` suelta (la de las funciones de arriba es un parámetro).
          resource.data.id_autor == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['texto', 'updated_at']) &&
          request.resource.data.updated_at == request.time &&
          request.resource.data.texto is string &&
          request.resource.data.texto.size() > 0 &&
          request.resource.data.texto.size() <= 4000;

        allow delete: if isAuthenticated() && (
          (
            esMiembroDelHilo(request.auth.uid) &&
            (
              resource.data.id_autor == request.auth.uid ||
              esAutorDelProyectoDelHilo(request.auth.uid)
            )
          ) ||
          // Huérfano: su requerimiento ya no existe.
          //
          // Es el único camino que puede recorrer el cascado de
          // `deleteRequerimiento` y `deleteProyecto`, que borran el requerimiento
          // ANTES que sus comentarios: una vez fuera, la comprobación de membresía
          // de arriba ya no puede resolverse porque no hay proyecto que leer. Si se
          // cambia ese orden, este permiso deja de valer y el servicio se queda con
          // comentarios huérfanos que nadie puede borrar. La rama es huérfana a
          // propósito, no es un hueco: el documento de referencia ya no existe.
          !exists(requerimientoDelHilo())
        );
      }
    }

    // 6. Historial de requerimientos: los miembros del proyecto pueden leer y
    // agregar entradas; una entrada creada nunca se puede editar ni borrar.
    match /logs_requerimientos/{logId} {
      function isProjectMemberForLog(requirementId) {
        let requirementPath = /databases/$(database)/documents/requerimiento/$(requirementId);
        return existsAfter(requirementPath) &&
          (
            esMiembroDeEquipoEnProyecto(
              getAfter(requirementPath).data.id_proyecto,
              getAfter(requirementPath).data.id_equipo,
              request.auth.uid
            ) ||
            esMiembroDelProyecto(
              getAfter(requirementPath).data.id_proyecto,
              request.auth.uid
            )
          );
      }

      allow read: if isAuthenticated() &&
        exists(/databases/$(database)/documents/requerimiento/$(resource.data.id_requerimiento)) &&
        (
          esMiembroDeEquipoEnProyecto(
            get(/databases/$(database)/documents/requerimiento/$(resource.data.id_requerimiento)).data.id_proyecto,
            get(/databases/$(database)/documents/requerimiento/$(resource.data.id_requerimiento)).data.id_equipo,
            request.auth.uid
          ) ||
          esMiembroDelProyecto(
            get(/databases/$(database)/documents/requerimiento/$(resource.data.id_requerimiento)).data.id_proyecto,
            request.auth.uid
          )
        );
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'id_requerimiento', 'accion', 'id_autor', 'id_lider_en_momento',
          'fecha_hora', 'detalles'
        ]) &&
        request.resource.data.keys().hasAll([
          'id_requerimiento', 'accion', 'id_autor', 'fecha_hora'
        ]) &&
        request.resource.data.id_autor == request.auth.uid &&
        request.resource.data.accion is string &&
        request.resource.data.fecha_hora is string &&
        isProjectMemberForLog(request.resource.data.id_requerimiento);
      allow update, delete: if false;
    }

    // 7. Patrones de Prompting / IA
    // Catálogo congelado (KAN-17): se lee y se copia, no se edita ni se borra.
    // `create` sigue abierta porque `seedCatalogsIfEmpty()` siembra desde el
    // cliente. Al ser la regla de este catálogo, también cubre las copias que se
    // creen en el futuro: una copia no es más editable ni más borrable que el
    // original.
    match /patron/{patronId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if puedeEditarCatalogos();
    }

    // Contexto del proyecto para la IA: archivos/carpetas y los fragmentos del archivo original.
    // Lectura como los requerimientos (cualquier autenticado); escritura solo de miembros del proyecto.
    // `id_proyecto` no puede cambiarse para no mover contexto a otro proyecto.
    match /contexto_proyecto/{archivoId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        esMiembroDelProyecto(request.resource.data.id_proyecto, request.auth.uid);
      allow update: if isAuthenticated() &&
        esMiembroDelProyecto(resource.data.id_proyecto, request.auth.uid) &&
        request.resource.data.id_proyecto == resource.data.id_proyecto;
      allow delete: if isAuthenticated() &&
        esMiembroDelProyecto(resource.data.id_proyecto, request.auth.uid);
    }
    match /contexto_fragmentos/{fragmentoId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        esMiembroDelProyecto(request.resource.data.id_proyecto, request.auth.uid);
      allow update: if isAuthenticated() &&
        esMiembroDelProyecto(resource.data.id_proyecto, request.auth.uid) &&
        request.resource.data.id_proyecto == resource.data.id_proyecto;
      allow delete: if isAuthenticated() &&
        esMiembroDelProyecto(resource.data.id_proyecto, request.auth.uid);
    }

    // Regla por defecto: denegar cualquier otra colección no especificada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
