rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Función auxiliar: verificar si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Función auxiliar: verificar si es el propietario del perfil
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isTeamLeaderUser(teamId, userId) {
      let memberPath = /databases/$(database)/documents/miembros_equipo/$(teamId + "_" + userId);
      return isAuthenticated() &&
        exists(memberPath) &&
        get(memberPath).data.id_rol != null &&
        isLeaderRole(get(memberPath).data.id_rol);
    }

    function isLeaderRole(roleId) {
      let rolePath = /databases/$(database)/documents/roles/$(roleId);
      return roleId != null &&
        exists(rolePath) &&
        get(rolePath).data.nombre_rol.matches('(?i).*l[ií]der.*');
    }

    function isTeamLeader(teamId) {
      return isTeamLeaderUser(teamId, request.auth.uid);
    }

    function isProjectCreator(projectId, userId) {
      let projectPath = /databases/$(database)/documents/proyecto/$(projectId);
      return exists(projectPath) && get(projectPath).data.id_creador == userId;
    }

    function isAcceptedLinkRequest(requestId, projectId, teamId) {
      let requestPath = /databases/$(database)/documents/solicitudes_proyecto_equipo/$(requestId);
      return getAfter(requestPath).data.tipo == 'vincular' &&
        getAfter(requestPath).data.estado == 'aceptada' &&
        getAfter(requestPath).data.id_proyecto == projectId &&
        getAfter(requestPath).data.id_equipo == teamId &&
        getAfter(requestPath).data.id_destinatario == request.auth.uid;
    }

    function isAcceptedUnlinkRequest(projectId, teamId) {
      let requestPath = /databases/$(database)/documents/solicitudes_proyecto_equipo/$(("desvincular_" + projectId) + "_" + teamId);
      return getAfter(requestPath).data.tipo == 'desvincular' &&
        getAfter(requestPath).data.estado == 'aceptada' &&
        getAfter(requestPath).data.id_proyecto == projectId &&
        getAfter(requestPath).data.id_equipo == teamId &&
        getAfter(requestPath).data.id_destinatario == request.auth.uid;
    }

    function isValidProjectTeamResponse(requestId, data) {
      let relationPath = /databases/$(database)/documents/proyecto_equipos/$(data.id_proyecto + "_" + data.id_equipo);
      return data.estado == 'rechazada' ||
        (
          data.estado == 'aceptada' &&
          (
            (
              data.tipo == 'vincular' &&
              isTeamLeader(data.id_equipo) &&
              existsAfter(relationPath) &&
              getAfter(relationPath).data.id_solicitud == requestId
            ) ||
            (
              data.tipo == 'desvincular' &&
              (
                isTeamLeader(data.id_equipo) ||
                isProjectCreator(data.id_proyecto, request.auth.uid)
              ) &&
              !existsAfter(relationPath)
            )
          )
        );
    }

    function isValidProjectTeamRequest(data, requestId) {
      let projectPath = /databases/$(database)/documents/proyecto/$(data.id_proyecto);
      let teamPath = /databases/$(database)/documents/equipo/$(data.id_equipo);
      let relationPath = /databases/$(database)/documents/proyecto_equipos/$(data.id_proyecto + "_" + data.id_equipo);
      return data.id_solicitante == request.auth.uid &&
        data.id_destinatario != request.auth.uid &&
        data.estado == 'pendiente' &&
        exists(projectPath) &&
        exists(teamPath) &&
        (
          (
            data.tipo == 'vincular' &&
            requestId == 'vincular_' + data.id_proyecto + "_" + data.id_equipo &&
            isProjectCreator(data.id_proyecto, request.auth.uid) &&
            isTeamLeaderUser(data.id_equipo, data.id_destinatario) &&
            !exists(relationPath)
          ) ||
          (
            data.tipo == 'desvincular' &&
            requestId == 'desvincular_' + data.id_proyecto + "_" + data.id_equipo &&
            exists(relationPath) &&
            (
              (
                isProjectCreator(data.id_proyecto, request.auth.uid) &&
                isTeamLeaderUser(data.id_equipo, data.id_destinatario)
              ) ||
              (
                isTeamLeader(data.id_equipo) &&
                isProjectCreator(data.id_proyecto, data.id_destinatario)
              )
            )
          )
        );
    }

    // KAN-24: el proyecto tiene miembros (su creador, que siempre lo es, y los que se agregan
    // directamente en `ids_miembros`) y los equipos se arman con ellos. Estas funciones replican
    // lib/equipos-proyecto.ts: si se cambia una, hay que cambiar la otra.
    function esMiembroDelProyecto(projectId, userId) {
      let projectPath = /databases/$(database)/documents/proyecto/$(projectId);
      return exists(projectPath) && (
        get(projectPath).data.get('id_creador', null) == userId ||
        userId in get(projectPath).data.get('ids_miembros', [])
      );
    }

    // Agregar y quitar miembros: el creador y los miembros que él autorizó (`ids_gestores_miembros`).
    function puedeGestionarMiembrosProyecto(projectId, userId) {
      let projectPath = /databases/$(database)/documents/proyecto/$(projectId);
      return exists(projectPath) && (
        get(projectPath).data.get('id_creador', null) == userId ||
        userId in get(projectPath).data.get('ids_gestores_miembros', [])
      );
    }

    // Crear equipos en el proyecto (campo `quien_crea_equipos`): solo el creador, los miembros
    // que él elija o cualquier miembro del proyecto.
    function puedeCrearEquipoEnProyecto(projectId, userId) {
      let projectPath = /databases/$(database)/documents/proyecto/$(projectId);
      return exists(projectPath) && (
        get(projectPath).data.get('id_creador', null) == userId ||
        (
          get(projectPath).data.get('quien_crea_equipos', 'creador') == 'miembros' &&
          userId in get(projectPath).data.get('ids_miembros', [])
        ) ||
        (
          get(projectPath).data.get('quien_crea_equipos', 'creador') == 'seleccionados' &&
          userId in get(projectPath).data.get('ids_creadores_equipos', [])
        )
      );
    }

    function isValidTeamRole(roleId) {
      return roleId == null ||
        exists(/databases/$(database)/documents/roles/$(roleId));
    }

    function isAllowedMemberCreate(memberId) {
      let teamPath = /databases/$(database)/documents/equipo/$(request.resource.data.id_equipo);
      let invitationPath = /databases/$(database)/documents/invitaciones_equipo/$(request.resource.data.id_equipo + "_" + request.auth.uid);
      return isAuthenticated() &&
        memberId == request.resource.data.id_equipo + "_" + request.resource.data.id_usuario &&
        request.resource.data.id_usuario == request.auth.uid &&
        (
          (
            existsAfter(teamPath) &&
            getAfter(teamPath).data.id_creador == request.auth.uid &&
            isLeaderRole(request.resource.data.id_rol)
          ) ||
          (
            existsAfter(invitationPath) &&
            getAfter(invitationPath).data.id_invitado == request.auth.uid &&
            getAfter(invitationPath).data.id_equipo == request.resource.data.id_equipo &&
            getAfter(invitationPath).data.id_rol == request.resource.data.id_rol &&
            getAfter(invitationPath).data.estado == 'aceptada'
          )
        );
    }

    // Catálogos de autoría compartida: `patron` y `modelo`.
    //
    // KAN-17: están congelados. Se leen y se copian, pero no se editan ni se
    // borran. `create` sigue abierta a propósito, por dos razones:
    //   1. `seedCatalogsIfEmpty()` siembra desde el cliente y necesita poder
    //      escribir; si se cierra, un entorno nuevo se queda sin catálogos.
    //   2. Es el mismo trato que recibe `match /roles`, donde el seed es lo
    //      único que crea y `update, delete` están negados.
    //
    // Punto de extensión para el sistema de roles. Todas las reglas de estos dos
    // catálogos pasan por aquí, así que conceder la edición a un rol es cambiar
    // un solo sitio, no perseguir reglas. Ojo: hay que replicarlo en
    // `puedeEditarCatalogos` de `lib/permisos.ts` para la interfaz, o al revés:
    // si solo cambia uno de los dos, la UI y el backend discreparán.
    function puedeEditarCatalogos() {
      return false;
    }

    // ==========================================
    // APROBACIÓN DE REQUERIMIENTOS (KAN-18)
    // ==========================================
    // Un requerimiento nuevo no entra al flujo: nace "Pendiente de aprobación" y
    // solo avanza cuando el líder de SU equipo lo aprueba.
    //
    // Por eso `requerimiento` guarda `id_equipo`. Un proyecto puede tener varios
    // equipos y los vínculos de `proyecto_equipos` tienen ID compuesto
    // (`proyecto_equipo`), así que las reglas NO pueden deducir el equipo leyendo
    // las relaciones: no hay forma de adivinar esos IDs desde el path. Con
    // `id_equipo` en el documento, la comprobación es una lectura de clave conocida.
    //
    // Puntos de extensión para el sistema de roles: `esAprobador` decide quién
    // aprueba, y las cuatro funciones de actualización de abajo son los únicos
    // sitios que deciden quién puede tocar el documento. Sus equivalentes en la
    // interfaz son las funciones de aprobación de `lib/permisos.ts`: se cambian
    // juntos, o la UI y el backend discrepan.

    // ¿Pertenece este equipo al proyecto del requerimiento?
    //
    // Desde KAN-24 los equipos que se crean dentro de un proyecto llevan
    // `id_proyecto`, así que basta una lectura. Los equipos anteriores no lo
    // tienen: se relacionan con el proyecto mediante el documento de
    // `proyecto_equipos`, cuyo ID es compuesto pero sí se puede construir. Por eso
    // se aceptan las dos formas.
    function isEquipoDelProyecto(equipoId, proyectoId) {
      let equipoPath = /databases/$(database)/documents/equipo/$(equipoId);
      return equipoId != null &&
        proyectoId != null &&
        (
          (
            exists(equipoPath) &&
            get(equipoPath).data.get('id_proyecto', null) == proyectoId
          ) ||
          exists(/databases/$(database)/documents/proyecto_equipos/$(proyectoId + "_" + equipoId))
        );
    }

    // ¿Puede este usuario aprobar los requerimientos de este equipo? Hoy, solo el
    // líder del propio equipo. Con roles, aquí se añadiría el criterio de rol.
    function esAprobador(equipoId, userId) {
      return isTeamLeaderUser(equipoId, userId);
    }

    // Los estados del ciclo de aprobación, comparados por su texto exacto.
    //
    // El catálogo guarda el nombre, no el significado: el significado de un ID
    // depende de lo que diga el documento `estados` al que apunta. Por eso `estados`
    // queda congelado como `roles`. Si alguien añadiera "Pendiente de aprobacion"
    // sin tilde, los requerimientos dejarían de reconocerse como pendientes y el
    // flujo se pararía sin error visible.
    function esEstadoPendienteAprobacion(estadoId) {
      let estadoPath = /databases/$(database)/documents/estados/$(estadoId);
      return estadoId != null &&
        exists(estadoPath) &&
        get(estadoPath).data.nombre_estado == 'Pendiente de aprobación';
    }

    function esEstadoAprobado(estadoId) {
      let estadoPath = /databases/$(database)/documents/estados/$(estadoId);
      return estadoId != null &&
        exists(estadoPath) &&
        get(estadoPath).data.nombre_estado == 'Aprobado';
    }

    function esEstadoRechazado(estadoId) {
      let estadoPath = /databases/$(database)/documents/estados/$(estadoId);
      return estadoId != null &&
        exists(estadoPath) &&
        get(estadoPath).data.nombre_estado == 'Rechazado';
    }

    // Alta de un requerimiento. Es la regla que impide el autoapartado: el autor lo
    // pone el sistema, el estado inicial lo pone la regla y el aprobador nace vacío.
    function isValidRequerimientoCreate(data) {
      return isAuthenticated() &&
        // Estar en el proyecto, que es lo que la interfaz ya comprobaba antes de
        // mostrar el botón de redactar. Antes bastaba `isAuthenticated()`, así que
        // cualquier usuario con sesión podía colgar requerimientos en proyectos
        // ajenos; esto es justo lo que este bloque deja de permitir.
        esMiembroDelProyecto(data.id_proyecto, request.auth.uid) &&
        isEquipoDelProyecto(data.id_equipo, data.id_proyecto) &&
        data.id_autor == request.auth.uid &&
        data.id_aprobador == null &&
        esEstadoPendienteAprobacion(data.id_estado) &&
        data.enunciado is string &&
        data.enunciado.size() > 0 &&
        data.enunciado.size() <= 5000 &&
        // Sin esta lista, un cliente podría colar campos propios y saltarse la
        // revisión de un schema que nadie ha visto. `numero` y `codigo` los escribe
        // la transacción de `createRequerimiento`, no el formulario.
        data.keys().hasOnly([
          'enunciado', 'id_tipo_requerimiento', 'id_proyecto', 'id_equipo',
          'id_autor', 'id_aprobador', 'id_modalidad', 'id_estado', 'id_modelo',
          'numero', 'codigo', 'created_at'
        ]);
    }

    // Un requerimiento se actualiza por UNA de estas cuatro situaciones. Se
    // declaran por separado para que se lea cuál es cuál.

    // 1. El autor corrige el suyo y lo devuelve a espera.
    function esReenvioDelAutor(data) {
      return isAuthenticated() &&
        resource.data.id_autor == request.auth.uid &&
        // `id_autor` es inmutable de por vida: es lo que demuestra quién pidió el
        // cambio. `numero` y `codigo` los mueve la renumeración, no una corrección.
        !data.diff(resource.data).affectedKeys().hasAny([
          'id_autor', 'id_proyecto', 'id_equipo', 'id_aprobador', 'numero', 'codigo'
        ]) &&
        // El estado solo puede cambiar para volver a espera. Sin esta condición, un
        // `updateDoc` a mano con el ID de "Aprobado" sería el autoapartado que este
        // ticket viene a cerrar.
        (
          !data.diff(resource.data).affectedKeys().hasAny(['id_estado']) ||
          esEstadoPendienteAprobacion(data.id_estado)
        );
    }

    // 2. El líder del equipo aprueba o rechaza.
    function esDecisionDelAprobador(data) {
      return esAprobador(resource.data.id_equipo, request.auth.uid) &&
        // Solo se decide lo que está esperando. Sin esto, un requerimiento ya
        // implementado podría volver a "Rechazado" con una llamada a mano.
        esEstadoPendienteAprobacion(resource.data.id_estado) &&
        data.diff(resource.data).affectedKeys().hasOnly(['id_estado', 'id_aprobador']) &&
        (esEstadoAprobado(data.id_estado) || esEstadoRechazado(data.id_estado)) &&
        // Aprobar exige registrar quién aprobó; rechazar exige dejarlo vacío,
        // porque quien rechaza no aprobó y si no el rechazo se mostraría como
        // "Aprobado por" en la tarjeta.
        (esEstadoAprobado(data.id_estado)
          ? data.id_aprobador == request.auth.uid
          : data.id_aprobador == null);
    }

    // 3. Superada la aprobación, el requerimiento vuelve al flujo normal y se edita
    // como antes: por cualquier miembro del proyecto. Sin esta vía, aprobar un
    // requerimiento lo dejaría congelado, que es lo contrario de lo que pide el
    // ticket ("continuará con el flujo normal del sistema").
    function esEdicionEnFlujoNormal(data) {
      return esMiembroDelProyecto(resource.data.id_proyecto, request.auth.uid) &&
        // Solo fuera del ciclo de aprobación: mientras esté pendiente o rechazado
        // manda el líder, y aquí no se cuela nadie.
        !esEstadoPendienteAprobacion(resource.data.id_estado) &&
        !esEstadoRechazado(resource.data.id_estado) &&
        !data.diff(resource.data).affectedKeys().hasAny([
          'id_autor', 'id_proyecto', 'id_equipo'
        ]);
    }

    // 4. Renumeración. Al insertar un requerimiento en medio, `insertarRequerimiento
    // DespuesDe` sube un número a todos los posteriores, y
    // `asignarNumerosRequerimientos` completa los que aún no lo tienen. Ninguna de
    // las dos toca el contenido, así que se admite solo ese par de campos: con esto
    // no se cuela ni un cambio de estado ni de autor por el mismo camino.
    function esRenumeracion(data) {
      return isAuthenticated() &&
        data.diff(resource.data).affectedKeys().hasOnly(['numero', 'codigo']);
    }

    // 1. Perfiles de usuario
    match /perfil_usuario/{userId} {
      // Cualquier usuario autenticado puede leer perfiles (necesario para listas de miembros, autores, etc.)
      allow read: if isAuthenticated();
      // Solo el propio usuario puede crear o editar su perfil
      allow write: if isOwner(userId);
    }

    // 2. Catálogos base (profesiones, roles, estados, modalidades, tipos, modelos)
    // Lectura para autenticados; escritura permitida para usuarios autenticados (permite el auto-seed inicial)
    match /profesiones/{docId} {
      // Lectura pública: el formulario de registro necesita el catálogo antes de que exista sesión.
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /tipos_sistema/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    match /roles/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['nombre_rol']) &&
        request.resource.data.nombre_rol in [
          'Líder de Equipo',
          'Analista de Requisitos',
          'Desarrollador',
          'Tester QA',
          'Product Owner'
        ];
      allow update, delete: if false;
    }
    match /estados/{docId} {
      allow read: if isAuthenticated();
      // Catálogo congelado (KAN-18), con el mismo trato que `roles`. No es
      // capricho: las reglas de aprobación comparan el nombre EXACTO del estado
      // (`esEstadoPendienteAprobacion`). Si cualquiera pudiera añadir "Pendiente de
      // aprobacion" sin tilde, renombrar el bueno o borrar el de "Aprobado", el
      // flujo se rompería sin error visible, o alguien se colaría en él.
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['nombre_estado']) &&
        request.resource.data.nombre_estado in [
          'Borrador',
          'En Revisión',
          'Aprobado',
          'Rechazado',
          'Implementado',
          'Pendiente de aprobación'
        ];
      allow update, delete: if false;
    }
    match /modalidades/{docId} {
      allow read: if isAuthenticated();
      // Congelado por el mismo motivo: 'Generado con IA' es la modalidad que el
      // botón de la IA marca sola, y el servicio la busca por ese texto.
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['nombre_modalidad']) &&
        request.resource.data.nombre_modalidad in [
          'Presencial',
          'Remoto',
          'Híbrido',
          'Obligatorio',
          'Opcional',
          'Generado con IA'
        ];
      allow update, delete: if false;
    }
    match /tipos_requerimientos/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    match /modelo/{docId} {
      allow read: if isAuthenticated();
      // El seed necesita crear. Editar y borrar, no: ver `puedeEditarCatalogos`.
      allow create: if isAuthenticated();
      allow update, delete: if puedeEditarCatalogos();
    }

    // 3. Proyectos
    // TODO(control-acceso): la lectura queda abierta a autenticados (política:
    // todo proyecto es visible para todo usuario autenticado, y cualquier
    // autenticado puede crear). La escritura debería limitarse a usuarios
    // relacionados al proyecto: creador (`resource.data.id_creador ==
    // request.auth.uid`) o miembro de un equipo vinculado vía
    // `proyecto_equipos` + `miembros_equipo`, pero la parte de membresía no
    // se puede resolver en `allow`: requeriría leer N documentos de
    // `miembros_equipo`/`proyecto_equipos` con IDs no predecibles desde el
    // path, lo que excede lo expresable en rules sin Cloud Functions /
    // backend con custom claims. El enforcement vive hoy en cliente+servicio
    // (helpers getProyectosRelacionados/isUsuarioRelacionadoAProyecto y gating
    // en app/). No endurecer aquí sin backend: se rompería el flujo actual
    // (incluidos proyectos legacy sin `id_creador`).
    match /proyecto/{proyectoId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.id_creador == request.auth.uid;
      allow update: if isAuthenticated() &&
        (
          (
            !resource.data.keys().hasAny(['id_creador']) &&
            !request.resource.data.keys().hasAny(['id_creador'])
          ) ||
          request.resource.data.id_creador == resource.data.id_creador
        ) &&
        // KAN-24: los permisos del proyecto (quién crea equipos y quién gestiona miembros) solo
        // los cambia su creador; la lista de miembros, el creador y los miembros que él autorizó
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'quien_crea_equipos', 'ids_creadores_equipos', 'quien_agrega_miembros', 'ids_gestores_miembros'
          ]) ||
          resource.data.get('id_creador', null) == request.auth.uid
        ) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ids_miembros']) ||
          resource.data.get('id_creador', null) == request.auth.uid ||
          request.auth.uid in resource.data.get('ids_gestores_miembros', [])
        );
      allow delete: if isAuthenticated();
    }

    // 4. Equipos y vinculaciones
    // Los vínculos proyecto-equipo solo se crean o eliminan al aceptar una
    // solicitud en la misma transacción. Las membresías iniciales se crean
    // junto al equipo; las demás, al aceptar una invitación de membresía.
    // La edición y eliminación de equipos y miembros queda reservada al líder.
    match /equipo/{equipoId} {
      allow read: if isAuthenticated();
      // KAN-24: todo equipo nuevo pertenece a un proyecto y lo crea quien el proyecto autoriza
      allow create: if isAuthenticated() &&
        request.resource.data.id_creador == request.auth.uid &&
        request.resource.data.id_proyecto is string &&
        puedeCrearEquipoEnProyecto(request.resource.data.id_proyecto, request.auth.uid);
      allow update: if isAuthenticated() &&
        isTeamLeader(equipoId) &&
        (
          (
            !resource.data.keys().hasAny(['id_creador']) &&
            !request.resource.data.keys().hasAny(['id_creador'])
          ) ||
          request.resource.data.id_creador == resource.data.id_creador
        ) &&
        request.resource.data.get('id_proyecto', null) == resource.data.get('id_proyecto', null);
      // Lo borra su líder o, cuando se elimina el proyecto, quien lo borró junto con él
      allow delete: if isAuthenticated() && (
        isTeamLeader(equipoId) ||
        (
          resource.data.get('id_proyecto', null) != null &&
          !exists(/databases/$(database)/documents/proyecto/$(resource.data.id_proyecto))
        )
      );
    }
    match /proyecto_equipos/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        (
          request.resource.data.keys().hasOnly(['id_proyecto', 'id_equipo', 'id_solicitud']) &&
          docId == request.resource.data.id_proyecto + "_" + request.resource.data.id_equipo &&
          request.resource.data.id_solicitud == "vincular_" + request.resource.data.id_proyecto + "_" + request.resource.data.id_equipo &&
          isAcceptedLinkRequest(
            request.resource.data.id_solicitud,
            request.resource.data.id_proyecto,
            request.resource.data.id_equipo
          ) &&
          isTeamLeader(request.resource.data.id_equipo)
        ) ||
        (
          // KAN-24: vínculo creado en el mismo lote que el equipo, por quien lo crea en el proyecto
          request.resource.data.keys().hasOnly(['id_proyecto', 'id_equipo']) &&
          docId == request.resource.data.id_proyecto + "_" + request.resource.data.id_equipo &&
          existsAfter(/databases/$(database)/documents/equipo/$(request.resource.data.id_equipo)) &&
          getAfter(/databases/$(database)/documents/equipo/$(request.resource.data.id_equipo)).data.id_proyecto == request.resource.data.id_proyecto &&
          getAfter(/databases/$(database)/documents/equipo/$(request.resource.data.id_equipo)).data.id_creador == request.auth.uid &&
          puedeCrearEquipoEnProyecto(request.resource.data.id_proyecto, request.auth.uid)
        )
      );
      allow update: if false;
      allow delete: if isAuthenticated() && (
        !exists(/databases/$(database)/documents/proyecto/$(resource.data.id_proyecto)) ||
        !exists(/databases/$(database)/documents/equipo/$(resource.data.id_equipo)) ||
        isAcceptedUnlinkRequest(resource.data.id_proyecto, resource.data.id_equipo)
      );
    }
    match /miembros_equipo/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAllowedMemberCreate(docId);
      // Solo el líder cambia los roles de un miembro (KAN-13). `id_rol` es el
      // primero de `id_roles` (el de líder, si lo tiene) y es el que usan
      // estas reglas para reconocer al líder.
      allow update: if isAuthenticated() &&
        isTeamLeader(resource.data.id_equipo) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['id_rol', 'id_roles']) &&
        request.resource.data.id_roles is list &&
        (
          (request.resource.data.id_roles.size() == 0 && request.resource.data.id_rol == null) ||
          (request.resource.data.id_roles.size() > 0 && request.resource.data.id_rol == request.resource.data.id_roles[0])
        ) &&
        isValidTeamRole(request.resource.data.id_rol);
      allow delete: if isAuthenticated() && (
        !exists(/databases/$(database)/documents/equipo/$(resource.data.id_equipo)) ||
        (
          isTeamLeader(resource.data.id_equipo) &&
          resource.data.id_usuario != request.auth.uid
        ) ||
        (
          // KAN-24: al quitar a alguien del proyecto, sale de los equipos del proyecto
          get(/databases/$(database)/documents/equipo/$(resource.data.id_equipo)).data.get('id_proyecto', null) != null &&
          puedeGestionarMiembrosProyecto(
            get(/databases/$(database)/documents/equipo/$(resource.data.id_equipo)).data.id_proyecto,
            request.auth.uid
          )
        )
      );
    }
    match /invitaciones_equipo/{invitationId} {
      allow get: if isAuthenticated() && (
        resource == null ||
        resource.data.id_invitado == request.auth.uid ||
        resource.data.id_invitador == request.auth.uid ||
        isTeamLeader(resource.data.id_equipo)
      );
      allow list: if isAuthenticated() && (
        resource.data.id_invitado == request.auth.uid ||
        resource.data.id_invitador == request.auth.uid ||
        isTeamLeader(resource.data.id_equipo)
      );
      allow create: if isAuthenticated() &&
        request.resource.data.id_invitador == request.auth.uid &&
        request.resource.data.estado == 'pendiente' &&
        request.resource.data.id_invitado != request.auth.uid &&
        invitationId == request.resource.data.id_equipo + "_" + request.resource.data.id_invitado &&
        isTeamLeader(request.resource.data.id_equipo) &&
        isValidTeamRole(request.resource.data.id_rol) &&
        // KAN-24: un equipo con proyecto solo invita a miembros de ese proyecto
        (
          get(/databases/$(database)/documents/equipo/$(request.resource.data.id_equipo)).data.get('id_proyecto', null) == null ||
          esMiembroDelProyecto(
            get(/databases/$(database)/documents/equipo/$(request.resource.data.id_equipo)).data.id_proyecto,
            request.resource.data.id_invitado
          )
        ) &&
        !exists(/databases/$(database)/documents/miembros_equipo/$(request.resource.data.id_equipo + "_" + request.resource.data.id_invitado));
      allow update: if isAuthenticated() && (
        (
          resource.data.id_invitado == request.auth.uid &&
          resource.data.estado == 'pendiente' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']) &&
          request.resource.data.estado in ['aceptada', 'rechazada']
        ) ||
        (
          resource.data.estado != 'pendiente' &&
          isTeamLeader(resource.data.id_equipo) &&
          request.resource.data.id_invitador == request.auth.uid &&
          request.resource.data.id_equipo == resource.data.id_equipo &&
          request.resource.data.id_invitado == resource.data.id_invitado &&
          request.resource.data.estado == 'pendiente' &&
          isValidTeamRole(request.resource.data.id_rol) &&
          !exists(/databases/$(database)/documents/miembros_equipo/$(resource.data.id_equipo + "_" + resource.data.id_invitado))
        )
      );
      allow delete: if isAuthenticated() && (
        isTeamLeader(resource.data.id_equipo) ||
        !exists(/databases/$(database)/documents/equipo/$(resource.data.id_equipo))
      );
    }
    match /solicitudes_proyecto_equipo/{requestId} {
      allow get: if isAuthenticated() && (
        resource == null ||
        resource.data.id_destinatario == request.auth.uid ||
        resource.data.id_solicitante == request.auth.uid ||
        !exists(/databases/$(database)/documents/proyecto/$(resource.data.id_proyecto)) ||
        !exists(/databases/$(database)/documents/equipo/$(resource.data.id_equipo))
      );
      allow list: if isAuthenticated() && (
        resource.data.id_destinatario == request.auth.uid ||
        resource.data.id_solicitante == request.auth.uid ||
        !exists(/databases/$(database)/documents/proyecto/$(resource.data.id_proyecto)) ||
        !exists(/databases/$(database)/documents/equipo/$(resource.data.id_equipo))
      );
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'id_proyecto', 'id_equipo', 'id_solicitante', 'id_destinatario',
          'tipo', 'estado', 'nombre_proyecto', 'nombre_equipo',
          'nombre_solicitante', 'created_at'
        ]) &&
        request.resource.data.keys().hasAll([
          'id_proyecto', 'id_equipo', 'id_solicitante', 'id_destinatario',
          'tipo', 'estado', 'nombre_proyecto', 'nombre_equipo',
          'nombre_solicitante', 'created_at'
        ]) &&
        isValidProjectTeamRequest(request.resource.data, requestId);
      allow update: if isAuthenticated() && (
        (
          resource.data.id_destinatario == request.auth.uid &&
          resource.data.estado == 'pendiente' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']) &&
          request.resource.data.estado in ['aceptada', 'rechazada'] &&
          isValidProjectTeamResponse(requestId, request.resource.data)
        ) ||
        (
          resource.data.estado != 'pendiente' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'id_solicitante', 'id_destinatario', 'estado',
            'nombre_solicitante', 'nombre_proyecto', 'nombre_equipo', 'created_at'
          ]) &&
          request.resource.data.id_proyecto == resource.data.id_proyecto &&
          request.resource.data.id_equipo == resource.data.id_equipo &&
          request.resource.data.tipo == resource.data.tipo &&
          isValidProjectTeamRequest(request.resource.data, requestId)
        )
      );
      allow delete: if isAuthenticated() && (
        resource.data.id_solicitante == request.auth.uid ||
        !exists(/databases/$(database)/documents/proyecto/$(resource.data.id_proyecto)) ||
        !exists(/databases/$(database)/documents/equipo/$(resource.data.id_equipo))
      );
    }

    // 5. Requerimientos con aprobación del líder del equipo (KAN-18)
    //
    // Antes era `allow read, write: if isAuthenticated()`: cualquier autenticado
    // podía crear, reescribir y borrar requerimientos, y autoaprobarse. Ahora el
    // autor lo pone el sistema, el estado inicial lo pone la regla, y aprobar es
    // solo del líder del equipo al que pertenece.
    //
    // Lo que sigue abierto: `delete`. KAN-18 habla de crear, editar y aprobar, no de
    // borrar, así que no se toca. Cerrar ese hueco aquí escondería un cambio de
    // comportamiento que nadie pidió, y dejaría KAN-18 mezclado con otro ticket.
    match /requerimiento/{requerimientoId} {
      allow read: if isAuthenticated();
      allow create: if isValidRequerimientoCreate(request.resource.data);
      allow update: if esReenvioDelAutor(request.resource.data) ||
        esDecisionDelAprobador(request.resource.data) ||
        esEdicionEnFlujoNormal(request.resource.data) ||
        esRenumeracion(request.resource.data);
      allow delete: if isAuthenticated();
    }

    // 6. Logs de auditoría de requerimientos (Inmutables: se pueden leer y crear, pero no modificar ni borrar)
    match /logs_requerimientos/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // 7. Patrones de Prompting / IA
    // Catálogo congelado (KAN-17): se lee y se copia, no se edita ni se borra.
    // `create` sigue abierta porque `seedCatalogsIfEmpty()` siembra desde el
    // cliente. Al ser la regla de este catálogo, también cubre las copias que se
    // creen en el futuro: una copia no es más editable ni más borrable que el
    // original.
    match /patron/{patronId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if puedeEditarCatalogos();
    }

    // Regla por defecto: denegar cualquier otra colección no especificada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
